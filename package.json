{
	"name": "jonaebert.de",
	"version": "26.11.0",
	"private": true,
	"engines": {
		"node": ">=22.17 || >=24 || >=25"
	},
	"scripts": {
		"build": "npm run gen:api && vite build",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"dev": "npm run gen:api && vite dev --host",
		"dev:local": "npm run gen:api && vite dev",
		"format": "prettier --write .",
		"gen:api": "node scripts/gen-openapi.mjs",
		"lint": "prettier --check . && eslint .",
		"prepare": "svelte-kit sync",
		"preview": "npm run gen:api && vite preview"
	},
	"devDependencies": {
		"@eslint/eslintrc": "^3.3.7",
		"@eslint/js": "^10.0.1",
		"@fortawesome/free-brands-svg-icons": "^7.3.1",
		"@fortawesome/free-solid-svg-icons": "^7.3.1",
		"@sveltejs/adapter-node": "^6.0.1",
		"@sveltejs/kit": "^3.1.1",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/vite": "^4.3.3",
		"@types/eslint": "^9.6.1",
		"@types/sanitize-html": "^2.16.2",
		"@typescript-eslint/eslint-plugin": "^8.72.1",
		"@typescript-eslint/parser": "^8.72.1",
		"boneyard-js": "^1.9.0",
		"dotenv": "^17.4.2",
		"eslint": "^10.11.0",
		"eslint-config-prettier": "^10.1.5",
		"eslint-plugin-svelte": "^3.23.0",
		"globals": "^17.12.0",
		"openapi-typescript": "^7.13.0",
		"prettier": "^3.9.9",
		"prettier-plugin-svelte": "^4.1.1",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.6",
		"svelte-routing": "^2.13.0",
		"tailwindcss": "^4.3.0",
		"tslib": "^2.8.1",
		"typescript": "^6.0.3",
		"vite": "^8.3.5"
	},
	"dependencies": {
		"sanitize-html": "^2.18.1",
		"svelte-fa": "^4.0.4"
	},
	"type": "module",
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	}
}
